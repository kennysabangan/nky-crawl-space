---
import BaseLayout from '../layouts/BaseLayout.astro';
import PhoneCTA from '../components/PhoneCTA.astro';
import { siteConfig } from '../config';

const { businessName, phone, siteUrl, serviceKeyword, city, cities, services } = siteConfig;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": siteUrl },
    { "@type": "ListItem", "position": 2, "name": "About Us", "item": `${siteUrl}/about/` },
  ],
};

const aboutPageSchema = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "name": `About ${businessName}`,
  "description": `${businessName} provides crawl space encapsulation, waterproofing, and mold remediation in ${city}.`,
  "mainEntity": {
    "@type": "LocalBusiness",
    "name": businessName,
    "telephone": siteConfig.phoneE164,
  },
};
---

<BaseLayout
  title={`About Us | ${businessName}`}
  description={`${businessName} repairs crawl spaces across Northern Kentucky: encapsulation, waterproofing, and mold remediation. How it works and where we go.`}
  canonicalURL={`${siteUrl}/about/`}
  schema={[breadcrumbSchema, aboutPageSchema]}
>

<section class="hero-section">
  <div class="container">
    <h1>About {businessName}</h1>
    <p class="hero-sub">Crawl space encapsulation, waterproofing, and mold remediation for Northern Kentucky homes.</p>
    <PhoneCTA />
  </div>
</section>

<div class="container py-6 text-center">
  <img
    src="/photos/team.jpg"
    alt="Crawl space repair crew"
    class="site-photo mx-auto max-w-2xl"
    loading="eager"
  />
</div>

<div class="content-section">
  <h2 class="text-brand text-xl md:text-2xl font-bold mb-4">What We Do</h2>

  <p>We fix the moisture problems under Northern Kentucky homes: damp soil, standing water, high humidity, mold on joists, and the musty smell and sagging floors that come with them. Northern Kentucky's humid summers, clay soils, and heavy spring rains make these problems common.</p>

  <ul>
    {services.map((s) => (
      <li><strong>{s.title}</strong> — {s.description}</li>
    ))}
  </ul>

  <h2 class="text-brand text-xl md:text-2xl font-bold mb-4 mt-8">How a Job Works</h2>

  <p><strong>1. Free inspection.</strong> Call {phone} or send the form. Tell us what you're noticing — musty odors, standing water, mold, sagging floors, high humidity — and we'll set up an inspection.</p>

  <p><strong>2. Written estimate.</strong> You get a written estimate that explains what was found and what fixes it — a vapor barrier, full encapsulation, a dehumidifier, a sump pump, drainage, mold treatment, or structural repair. No obligation.</p>

  <p><strong>3. The work.</strong> Most encapsulations take 1-2 days. Before the crew leaves, they'll walk you through what was done.</p>

  <h2 class="text-brand text-xl md:text-2xl font-bold mb-4 mt-8">Where We Work</h2>

  <p>Our main service areas are {cities.map((c) => c.name.replace(/, KY$/, '')).join(', ')}:</p>

  <ul>
    {cities.map((c) => (
      <li><a href={`/crawl-space/${c.slug}/`}>Crawl space repair in {c.name}</a></li>
    ))}
  </ul>

  <p>Close by but not on the list? Call {phone} and ask — nearby towns are often fine.</p>
</div>

<section class="bg-gray-50 border-y-2 border-brand">
  <div class="cta-strip container">
    <p class="cta-heading">Ready to Protect Your Home?</p>
    <p class="cta-sub">Call now for a free crawl space inspection.</p>
    <PhoneCTA />
  </div>
</section>

</BaseLayout>
